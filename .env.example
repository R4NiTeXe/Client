# Public (non-secret) Cloudinary cloud name used for image delivery.
# VITE_* values are exposed in the browser — NEVER put the Cloudinary
# API secret here or in any VITE_ variable.
VITE_CLOUDINARY_CLOUD_NAME=
# Public folder that holds the business images (no trailing slash).
VITE_CLOUDINARY_FOLDER=atoz-engraving
